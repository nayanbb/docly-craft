# Docly Server Environment Template
# Copy to .env and configure for local development

# -----------------------------------------------------------------------------
# 1. Docly Self-Hosted Document Conversion Microservice (Primary)
# -----------------------------------------------------------------------------
# Connects to services/converter (Python FastAPI + LibreOffice headless)
# Local: cd services/converter && python -m uvicorn src.server:app --port 8001
# Docker: cd services/converter && docker compose up -d
DOCLY_CONVERTER_URL=http://localhost:8001
# DOCLY_CONVERTER_SECRET=docly_converter_dev_secret

# -----------------------------------------------------------------------------
# 2. Office -> PDF Conversions (Legacy Gotenberg Fallback)
# -----------------------------------------------------------------------------
# Option A: Gotenberg (Self-hosted LibreOffice via Docker)
# Start Gotenberg: docker run --rm -p 3000:3000 gotenberg/gotenberg:8
# GOTENBERG_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 3. Optional CloudConvert Fallback (Disabled by default)
# -----------------------------------------------------------------------------
# CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here
# CLOUDCONVERT_FALLBACK=false

# -----------------------------------------------------------------------------
# 3. Supabase Authentication & User Accounts (Phase 6)
# -----------------------------------------------------------------------------
# Public anon credentials used by browser client for Supabase Auth
# NEVER expose a service_role key to VITE_* or frontend code!
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -----------------------------------------------------------------------------
# 4. Docly AI Provider (Phase 4)
# -----------------------------------------------------------------------------
# Server-side API key for Chat with PDF & AI Document Tools
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# 5. Razorpay Payments & Subscriptions (Docly Pro ₹25/month)
# -----------------------------------------------------------------------------
# Razorpay Merchant Key ID (Public/Checkout identifier)
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Merchant Key Secret (STRICTLY SERVER-SIDE - never prefix with VITE_)
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Pro Plan ID for ₹25/month recurring subscription
# RAZORPAY_PRO_PLAN_ID=plan_your_plan_id_here

# Razorpay Webhook Secret for HMAC-SHA256 signature verification
# RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Supabase Service Role Key (STRICTLY SERVER-SIDE - for webhook updates & admin queries)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Admin User Emails (comma-separated list of emails with access to /admin)
# ADMIN_EMAILS=admin@docly.com



